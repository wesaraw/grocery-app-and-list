{
  "manifest_version": 3,
  "name": "Grocery App",
  "version": "2.0",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "ui/priceChecker.html"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scrapers/index.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/16.png", "icons/48.png", "icons/128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
